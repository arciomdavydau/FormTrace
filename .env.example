# Fictional built-in data; set to false to read your own Hevy history.
FITNESS_DEMO_MODE=true

# Used only when FITNESS_DEMO_MODE=false. Keep your actual key in .env or your client environment.
HEVY_API_KEY=
HEVY_API_BASE_URL=https://api.hevyapp.com/v1

# Dates in reports use this IANA timezone by default.
FITNESS_TIMEZONE=Europe/Warsaw
FITNESS_CACHE_SECONDS=300
REQUEST_TIMEOUT=30
MAX_RETRIES=3
LOG_LEVEL=INFO
