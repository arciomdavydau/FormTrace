# ==========================================
# Health & Fitness MCP Hub Environment Config
# ==========================================

# MCP Server Configuration
MCP_SERVER_NAME=fitness-mcp-server
MCP_TRANSPORT=stdio          # Options: stdio (Claude Desktop / IDE) or sse (HTTP server mode)
MCP_HOST=0.0.0.0
MCP_PORT=8000
LOG_LEVEL=INFO

# Open Wearables API Configuration
OPEN_WEARABLES_API_URL=https://example.invalid
OPEN_WEARABLES_API_KEY=
OPEN_WEARABLES_DEFAULT_USER_ID=
OPEN_WEARABLES_TIMEOUT=30.0

# Hevy API Configuration (Hevy Pro API key from hevy.com/settings?developer)
HEVY_API_URL=https://api.hevyapp.com/v1
HEVY_API_KEY=
HEVY_TIMEOUT=30.0

# Nutrition Configuration
NUTRITION_PROVIDER=manual    # Options: manual, myfitnesspal
NUTRITION_DATA_PATH=./data/nutrition_logs.json
MYFITNESSPAL_USERNAME=
MYFITNESSPAL_PASSWORD=

# Client Connection Defaults
REQUEST_TIMEOUT=30.0
MAX_RETRIES=3
BACKOFF_FACTOR=0.5
