# Fitness MCP Hub Configuration

# MCP Gateway Server
MCP_SERVER_NAME=fitness-mcp-hub
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
LOG_LEVEL=INFO

# Open Wearables API (Biometrics & Sleep)
OPEN_WEARABLES_BASE_URL=http://localhost:8080
OPEN_WEARABLES_API_KEY=

# Hevy API (Strength Workouts & Volumes)
HEVY_API_BASE_URL=https://api.hevyapp.com/v1
HEVY_API_KEY=

# Nutrition Provider (local or myfitnesspal)
NUTRITION_PROVIDER=local
NUTRITION_DATA_PATH=./data/nutrition_logs.json

# Daily Fitness & Macro Targets
TARGET_DAILY_CALORIES=2200
TARGET_PROTEIN_G=180
TARGET_DAILY_STEPS=9000

# Client Configuration
REQUEST_TIMEOUT=30.0
MAX_RETRIES=3
